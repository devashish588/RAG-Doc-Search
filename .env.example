# Production environment template — Phase 9
# Copy to .env and fill in secrets.  Never commit .env.

ENVIRONMENT=production
LOG_LEVEL=INFO

# LLM (optional — leave empty to disable LLM answers)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# CORS (comma-separated origins, or "*" for development)
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Circuit breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# Reranker (opt-in)
RERANKER_ENABLED=false
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2

# Confidence & grounding
CONFIDENCE_THRESHOLD=0.50

# Request limits
MAX_UPLOAD_MB=25
MAX_TOP_K=50
MAX_TOP_K_FINAL=20
REQUEST_TIMEOUT=60
